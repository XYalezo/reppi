{
  "color": {
    "white": "#ffffff",
    "mist": "#edf2f1",
    "ink": {
      "200": "#d3dce6",
      "300": "#b1c0d4",
      "500": "#66788c",
      "600": "#475a6e",
      "700": "#304665",
      "800": "#0d1f33",
      "900": "#071324"
    },
    "green": {
      "50": "#ecfbf2",
      "100": "#d0f5e0",
      "200": "#a7ebc6",
      "300": "#6af5ac",
      "400": "#1ee07a",
      "500": "#18ef81",
      "600": "#0e9b4b",
      "700": "#0b7f41",
      "800": "#066f3a",
      "900": "#034b2f",
      "950": "#02281f"
    }
  },
  "font": {
    "display": "var(--font-archivo), \"Arial Narrow\", Arial, sans-serif",
    "body": "var(--font-plex-sans), system-ui, \"Segoe UI\", sans-serif",
    "mono": "var(--font-plex-mono), ui-monospace, \"Cascadia Mono\", monospace"
  },
  "text": {
    "display-sm": { "size": "clamp(2rem, 1.4rem + 2.6vw, 3.75rem)", "lineHeight": "1.06", "tracking": "0", "range": "32px at 360, 60px at 1440", "family": "Archivo, weight 900, width 76, word-spacing 0.2em", "use": "H1 longer than 36 characters" },
    "display": { "size": "clamp(2.5rem, 1.75rem + 3.333vw, 4.75rem)", "lineHeight": "1.04", "tracking": "0", "range": "40px at 360, 76px at 1440", "family": "Archivo, weight 900, width 76, word-spacing 0.2em", "use": "H1" },
    "heading": { "size": "clamp(2rem, 1.583rem + 1.852vw, 3.25rem)", "lineHeight": "1.08", "tracking": "0", "range": "32px at 360, 52px at 1440", "family": "Archivo, weight 900, width 76", "use": "H2" },
    "heading-sm": { "size": "clamp(1.625rem, 1.333rem + 1.296vw, 2.5rem)", "lineHeight": "1.1", "tracking": "0", "range": "26px at 360, 40px at 1440", "family": "Archivo, weight 900, width 76", "use": "H2 longer than 32 characters" },
    "title": { "size": "clamp(1.375rem, 1.25rem + 0.556vw, 1.75rem)", "lineHeight": "1.2", "tracking": "0", "range": "22px at 360, 28px at 1440", "family": "Archivo, weight 800, width 76", "use": "H3, block titles" },
    "wordmark": { "size": "1.3125rem", "lineHeight": "1", "tracking": "0.01em", "range": "21px fixed", "family": "Archivo, weight 800, width 125", "use": "PHANELLO line of the logo lockup" },
    "wordmark-sub": { "size": "0.6rem", "lineHeight": "1", "tracking": "1.04em", "range": "9.6px fixed", "family": "Archivo, weight 400, width 125", "use": "SOLUTIONS line of the logo lockup" },
    "lead": { "size": "clamp(1.125rem, 1.083rem + 0.185vw, 1.25rem)", "lineHeight": "1.5", "tracking": "0", "range": "18px at 360, 20px at 1440", "family": "IBM Plex Sans 400", "use": "Section ledes" },
    "body": { "size": "1rem", "lineHeight": "1.625", "tracking": "0", "range": "16px", "family": "IBM Plex Sans 400", "use": "Running text" },
    "small": { "size": "0.875rem", "lineHeight": "1.571", "tracking": "0", "range": "14px", "family": "IBM Plex Sans 400", "use": "Notes, footer, table detail" },
    "label": { "size": "0.875rem", "lineHeight": "1.429", "tracking": "0.08em", "range": "14px", "family": "IBM Plex Mono 500, uppercase", "use": "Eyebrows, numerals, small labels" }
  },
  "spacing": {
    "base": 4,
    "steps": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128, 160]
  },
  "container": {
    "measure": "45rem",
    "narrow": "28rem",
    "page": "105rem",
    "wide": "105rem"
  },
  "radius": {
    "none": "0",
    "sm": "2px",
    "md": "4px"
  },
  "shadow": {
    "float": "0 12px 32px color-mix(in srgb, var(--color-ink-900) 18%, transparent)"
  },
  "motion": {
    "ease": [
      0.2,
      0,
      0,
      1
    ],
    "duration": {
      "fast": 150,
      "base": 250,
      "slow": 400
    }
  }
}
